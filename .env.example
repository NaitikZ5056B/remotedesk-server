# RemoteDesk Signaling Server Configuration
# Copy to .env and fill in your values

# Server
PORT=4000
HOST=0.0.0.0

# Security
JWT_SECRET=change-me-to-a-random-64-char-string
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# TURN Server (coturn)
TURN_SERVER=turn:your-turn-server.com:3478
TURN_USERNAME=remotedesk
TURN_PASSWORD=change-me
TURN_SECRET=change-me

# Logging
LOG_LEVEL=info
